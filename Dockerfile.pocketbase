FROM ghcr.io/muchobien/pocketbase:0.28.4

# Bake migrations into the image so Coolify persistent volumes cannot shadow an empty dir.
COPY pocketbase/pb_migrations /pb_migrations
COPY scripts/pb-entrypoint.sh /usr/local/bin/pb-entrypoint.sh
RUN chmod +x /usr/local/bin/pb-entrypoint.sh

ENV PB_DIR=/pb_data \
    PB_MIGRATIONS_DIR=/pb_migrations

ENTRYPOINT ["/usr/local/bin/pb-entrypoint.sh"]
EXPOSE 8090

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=20s \
  CMD wget -q --spider http://127.0.0.1:8090/api/health || exit 1
