VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Production (Docker/Coolify): leave empty so the site uses same-origin
# and nginx proxies /api and /_ to PocketBase.
# VITE_POCKETBASE_URL=

# Used at container start (auto superuser upsert + seed) and by scripts/seed.mjs.
# Set the same keys in Coolify env for production.
PB_ADMIN_EMAIL=admin@cozycafe.local
PB_ADMIN_PASSWORD=changeme-admin-password

# Auto-seed on PocketBase boot when collections are empty (default true).
PB_SEED_ON_START=true
# Set to 1 to wipe and re-seed menu/settings on next container start.
# PB_FORCE_SEED=1
